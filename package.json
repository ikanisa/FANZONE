{
  "name": "fanzone-monorepo",
  "private": true,
  "description": "FANZONE Super-App Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w @fanzone/admin",
    "dev:website": "npm run dev -w @fanzone/website",
    "dev:venue": "npm run dev -w @fanzone/venue-portal",
    "dev:tv": "npm run dev -w @fanzone/tv-display",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:flutter-mobile-ux": "node tool/validate_flutter_mobile_ux_matrix.mjs",
    "generate:flutter-mobile-ux-summary": "node tool/generate_flutter_mobile_ux_summary.mjs --write",
    "validate:flutter-mobile-ux-summary": "node tool/generate_flutter_mobile_ux_summary.mjs --check",
    "validate:fullstack-platform": "node tool/validate_fullstack_platform_completion_matrix.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "~6.0.2"
  }
}
